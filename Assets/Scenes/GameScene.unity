--- !u!114 &829562859
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 829562858}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 63977a31a5b915d45baf80dbb833aa77, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  instructions: "\r\nGAME START ANIMATION SETUP:\r\n\r\n1. CAMERA POSITIONS:\r\n  
    - Create empty GameObjects for camera start/end positions\r\n   - Start position:
    High above arena (y=20), looking down (rotation: 90,0,0)\r\n   - Final position:
    Normal gameplay camera position\r\n\r\n2. LEGEND STONE POSITIONS:\r\n   - Create
    empty GameObjects for underground hatch positions  \r\n   - Hatch positions:
    Same X,Z as final but Y = -2 (underground)\r\n   - Final positions: Normal LegendStone
    positions in scene\r\n\r\n3. PARTICLE EFFECTS:\r\n   - Add dust particle effects
    at each hatch position\r\n   - Configure to play when stones rise from ground\r\n\r\n4.
    AUDIO:\r\n   - Assign countdown beeps and rising sounds\r\n   - Use separate
    AudioSources for different effects\r\n\r\n5. COUNTDOWN UI:\r\n   - Create TextMeshPro
    text for countdown display\r\n   - Should be initially inactive (script will
    enable it)\r\n"
  arenaCenter: {fileID: 728306078}
  cameraStartHeight: 20
  legendStoneUndergroundDepth: -2
  autoSetupButton: 0
  createCameraStartButton: 0
  createHatchPositionsButton: 0
